# ====================================================================
# BIẾN MÔI TRƯỜNG MẪU CHO DỰ ÁN ĐỀ 32 — CHAT/MESSAGING SYSTEM
# Sao chép file này thành .env trước khi chạy Docker Compose:
# powershell: Copy-Item .env.example .env
# ====================================================================

# --------------------------------------------------------------------
# 1. CỔNG MÁY HOST (Host Port Bindings)
# Lưu ý: Các cổng này được cấu hình để tránh xung đột với các ứng dụng khác trên máy
# --------------------------------------------------------------------
NGINX_HTTPS_PORT=8443
NGINX_HTTP_PORT=8084
GRAFANA_PORT=3003
PROMETHEUS_PORT=9092
PGADMIN_PORT=5052

# --------------------------------------------------------------------
# 2. CƠ SỞ DỮ LIỆU POSTGRESQL (Tầng Cô Lập Nội Bộ)
# --------------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_NAME=chat_db
DB_USER=chat_user
DB_PASSWORD=CHANGE_ME

# PostgreSQL Superuser (Chỉ dùng cho khởi tạo hệ thống và bảo trì)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME

# --------------------------------------------------------------------
# 3. ỨNG DỤNG NODE.JS BACKEND (Chat App)
# --------------------------------------------------------------------
NODE_ENV=production
PORT=3000
JWT_SECRET=CHANGE_ME_USE_A_RANDOM_SECRET
# Thời hạn hiệu lực của JWT token (ví dụ: 24h, 1h, 30m)
JWT_EXPIRES_IN=24h
LOG_LEVEL=info
# Danh sách origin được phép gọi API (phân tách bằng dấu phẩy).
# Frontend được phục vụ cùng origin qua Nginx nên CORS chủ yếu cho truy cập chéo origin.
# Dùng "*" để cho phép mọi origin (KHÔNG khuyến khích khi triển khai thực tế).
CORS_ORIGIN=https://localhost:8443
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=20

# --------------------------------------------------------------------
# 3B. TÀI KHOẢN QUẢN TRỊ (ADMIN) CHÍNH THỨC — Tạo bằng script (tùy chọn)
# KHÔNG đặt mật khẩu thật vào mã nguồn / git. Chỉ điền tại .env cục bộ.
# Sau khi điền 3 biến dưới, chạy:
#   docker compose exec chat-app node src/scripts/create-admin.js
# Mật khẩu được băm bằng bcrypt trước khi lưu; script sẽ không ghi đè tài
# khoản đã tồn tại và không tự tạo lại nếu username đã là admin.
# --------------------------------------------------------------------
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --------------------------------------------------------------------
# 4. GIAO DIỆN QUẢN TRỊ PGADMIN 4
# --------------------------------------------------------------------
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME

# --------------------------------------------------------------------
# 5. GIÁM SÁT GRAFANA
# --------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
